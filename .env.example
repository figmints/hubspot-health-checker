# HubSpot OAuth Configuration
# Get these from https://app.hubspot.com/l/settings/apps/developer-apps

# Your HubSpot App's Client ID
HUBSPOT_CLIENT_ID=your-client-id-here

# Your HubSpot App's Client Secret
# KEEP THIS SECRET! Never commit the actual value.
HUBSPOT_CLIENT_SECRET=your-client-secret-here

# OAuth Redirect URI
# Must match exactly what you configured in your HubSpot app
# For local development: http://localhost:3000/api/auth/callback
# For production: https://yourdomain.com/api/auth/callback
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Session encryption secret
# Generate with: openssl rand -hex 32
# This MUST be at least 32 characters for iron-session
SESSION_SECRET=your-session-secret-here-minimum-32-characters

# Optional: API base URL (defaults to https://api.hubapi.com)
# HUBSPOT_API_BASE=https://api.hubapi.com

# Stripe Configuration (for Premium tier)
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe Webhook Secret (get after creating webhook in Stripe Dashboard)
# Webhook URL: https://yourdomain.com/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Optional: Pre-created price ID (speeds up checkout)
# STRIPE_PRICE_ID=price_xxx

# Base URL for redirects
NEXT_PUBLIC_BASE_URL=https://hubspot-health.figmints.net
